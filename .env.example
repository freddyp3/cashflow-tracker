# Copy to .env and uncomment what you want to change. Every value below is the default.

# Host port for the React UI (nginx, proxies /api to the Spring API)
#UI_PORT=3000
# Host port for the Spring API
#API_PORT=8080
# Goroutine pool size / max outstanding Pub/Sub messages in the worker
#WORKER_CONCURRENCY=4
# Where the worker upserts orders; override when the API runs outside compose (e.g. http://host.docker.internal:8080)
#TRACKER_API_URL=http://app:8080
# Directory mounted at /secrets in the worker; put gmail_token.json here (git-ignored)
#GMAIL_CREDENTIALS_DIR=./worker/credentials
