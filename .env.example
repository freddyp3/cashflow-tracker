# Copy to .env and uncomment what you want to change. Every value below is the default.

# Host port for the React UI (nginx, proxies /api to the Spring API)
#UI_PORT=3000
# Host port for the Spring API
#API_PORT=8080
# Goroutine pool size / max outstanding Pub/Sub messages in the worker
#WORKER_CONCURRENCY=4
# Where the worker upserts orders; override when the API runs outside compose (e.g. http://host.docker.internal:8080)
#TRACKER_API_URL=http://app:8080
# Directory mounted at /secrets in the worker; put gmail_token.json here (git-ignored)
#GMAIL_CREDENTIALS_DIR=./worker/credentials

# Production worker (docker-compose.prod.yml)
# GCP project that hosts the Pub/Sub topic/subscription — required for prod
#PUBSUB_PROJECT_ID=
# Notification topic Gmail watch() publishes to
#PUBSUB_TOPIC=gmail-notifications
# Pull subscription the worker consumes
#PUBSUB_SUBSCRIPTION=gmail-notifications-worker
# Dead-letter topic; must match the subscription's deadLetterPolicy
#PUBSUB_DLQ_TOPIC=gmail-notifications-dlq
# Delivery attempts before Pub/Sub dead-letters a message
#WORKER_MAX_ATTEMPTS=5
